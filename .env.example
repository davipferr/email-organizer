# Copy to .env and fill in. Never commit .env.

# --- Production only: the domain pointing at your VPS (Caddy gets HTTPS for it) ---
DOMAIN=mail.example.com

# --- PostgreSQL ---
POSTGRES_USER=mail
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mail_organizer

# --- Backend (local dev) ---
# In Docker, DATABASE_URL and APP_URL are built from the values above (see docker-compose.yml).
DATABASE_URL=postgresql://mail:change-me@localhost:5433/mail_organizer
APP_URL=http://localhost:5173

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URIs:
#   http://localhost:5173/api/auth/google/callback      (dev)
#   https://<DOMAIN>/api/auth/google/callback           (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes stored tokens unreadable (users just log in again).
TOKEN_ENCRYPTION_KEY=

# --- Ask your mailbox (optional) ---
# Claude Platform (platform.claude.com) → API keys. Without it, the Ask page shows
# "not set up". Questions send email metadata, and the text of emails Claude opens, to Anthropic.
ANTHROPIC_API_KEY=

# --- Local development only ---
# Enables "Dev login (fake mailbox)" on the login page (/api/auth/dev-login): a fake
# in-memory mailbox, no Google account needed. Used by Claude to test the app.
# The backend refuses to start if this is true in production.
DEV_LOGIN=false
